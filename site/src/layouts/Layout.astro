---
import '../styles/global.css';
import { book, seo } from '../data/site';
import { publicPath } from '../utils/publicPath';

interface Props {
  title?: string;
  description?: string;
}

const pageTitle = Astro.props.title ?? seo.title;
const description = Astro.props.description ?? seo.description;
const canonicalUrl = seo.siteUrl
  ? new URL(Astro.url.pathname, `${seo.siteUrl}/`).toString()
  : undefined;
const faviconHref = publicPath('brand/favicon.svg');
const socialImage = seo.siteUrl
  ? new URL(seo.image, `${seo.siteUrl}/`).toString()
  : seo.image;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: book.title,
  alternateName: book.eyebrow,
  headline: book.subtitle,
  description,
  author: { '@type': 'Person', name: book.author },
  translator: { '@type': 'Person', name: book.translator },
  inLanguage: 'zh-CN',
  numberOfPages: book.pages,
  bookFormat: 'https://schema.org/Paperback',
  datePublished: String(book.editionYear),
  copyrightNotice: `译文与排版 © ${book.editionYear} ${book.translator}。保留所有权利。`,
  ...(canonicalUrl ? { url: canonicalUrl } : {}),
  ...(seo.siteUrl ? { image: socialImage } : {}),
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#18151c" />

    <link rel="icon" href={faviconHref} type="image/svg+xml" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:type" content="book" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={book.eyebrow} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={`《${book.title}》中文版主题分享图`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={`《${book.title}》中文版主题分享图`} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳至正文</a>
    <slot />
    <style is:global>
      /* 3D 书封效果 —— 鼠标悬停时封面旋转露出书厚 */
      .book-container {
        display: flex;
        align-items: center;
        justify-content: center;
        perspective: 600px;
        margin: 0 auto;
      }

      @keyframes bookInitAnimation {
        0% {
          transform: rotateY(0deg);
        }
        100% {
          transform: rotateY(-30deg);
        }
      }

      .book {
        width: 300px;
        height: 480px;
        position: relative;
        transform-style: preserve-3d;
        transform: rotateY(-30deg);
        transition: 1s ease;
        animation: 1s ease 0s 1 bookInitAnimation;
      }

      .book:hover {
        transform: rotateY(0deg);
      }

      .book > :first-child {
        position: absolute;
        top: 0;
        left: 0;
        width: 300px;
        height: 480px;
        transform: translateZ(25px);
        background-color: #01060f;
        border-radius: 0 2px 2px 0;
        box-shadow: 5px 5px 20px #666;
        overflow: hidden;
      }

      .book > :first-child img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .book::before {
        position: absolute;
        content: ' ';
        left: 0;
        top: 3px;
        width: 48px;
        height: 476px;
        transform: translateX(272px) rotateY(90deg);
        background: linear-gradient(
          90deg,
          #999894 0%,
          #c8c4ba 5%,
          #e5dfd1 11%,
          #f4eddd 18%,
          #ebe3d2 25%,
          #faf3e4 34%,
          #e9e0ce 43%,
          #f7efdf 52%,
          #e8dfcd 61%,
          #f8f1e2 70%,
          #e9e0cf 79%,
          #f5eddd 88%,
          #d7d0c1 94%,
          #151515 97%,
          #000 100%
        );
      }

      .book::after {
        position: absolute;
        top: 0;
        left: 0;
        content: ' ';
        width: 300px;
        height: 480px;
        transform: translateZ(-25px);
        background-color: #01060f;
        border-radius: 0 2px 2px 0;
        box-shadow: -10px 0 50px 10px #666;
      }

      @media (prefers-reduced-motion: reduce) {
        .book {
          animation: none;
          transition: none;
        }
      }
    </style>
  </body>
</html>
